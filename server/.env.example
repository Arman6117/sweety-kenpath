# Server Port (default: 5000)
PORT=5000

# PostgreSQL Connection String (Local PostgreSQL or Neon Cloud with connection pooling)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sweety_db?sslmode=require&pgbouncer=true&connect_timeout=15"

# JSON Web Token Secret (replace with a long random secret)
JWT_SECRET="replace_with_a_long_random_secret"

# Token Expiration Duration (optional, default: 1d)
JWT_EXPIRES_IN="1d"

# Authorized Client Origin for CORS (optional, default: http://localhost:5173)
CLIENT_ORIGIN="http://localhost:5173"
